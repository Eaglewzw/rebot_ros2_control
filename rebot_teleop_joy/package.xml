<?xml version="1.0" encoding="utf-8"?>
<package format="3">
  <name>rebot_teleop_joy</name>
  <version>0.1.0</version>
  <description>
    Single Joy-Con motion teleoperation for the reBot Arm B601-DM: IMU
    attitude + stick + buttons, joint and cartesian modes with deadman-clutch
    semantics. IMU acquisition vendored from Eaglewzw/JoyReBot (joyconrobotics).
  </description>

  <maintainer email="1460853569@qq.com">Eaglewzw</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>control_msgs</depend>
  <depend>python_orocos_kdl_vendor</depend>
  <depend>urdfdom_py</depend>
  <exec_depend>rebot_bringup</exec_depend>
  <exec_depend>rebot_controllers</exec_depend>

  <!-- Non-rosdep python deps (pip): hidapi, pyglm, scipy, numpy.
       placo is optional; cartesian IK falls back to weighted DLS without it. -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
