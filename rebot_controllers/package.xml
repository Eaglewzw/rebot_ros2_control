<?xml version="1.0" encoding="utf-8"?>
<package format="3">
  <name>rebot_controllers</name>
  <version>0.1.0</version>
  <description>
    Custom ros2_controllers for the reBot Arm B601-DM exploiting the Damiao
    MIT mode (position/velocity/kp/kd/effort tuple): passthrough, gravity
    compensation, MIT trajectory, joint impedance and teleop streaming.
  </description>

  <maintainer email="1460853569@qq.com">Eaglewzw</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>generate_parameter_library</buildtool_depend>

  <depend>controller_interface</depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>realtime_tools</depend>
  <depend>control_msgs</depend>
  <depend>lifecycle_msgs</depend>
  <depend>std_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>rebot_msgs</depend>
  <depend>kdl_parser</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>controller_manager</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
